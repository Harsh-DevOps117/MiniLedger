# Local-only defaults. Replace secrets before deploying beyond your own machine.
POSTGRES_USER=miniledger
POSTGRES_PASSWORD=miniledger_local
POSTGRES_DB=miniledger
DATABASE_URL=postgresql://miniledger:miniledger_local@localhost:5432/miniledger
JWT_SECRET=local-only-jwt-secret-change-me-at-least-32-chars
OTP_SECRET=local-only-otp-secret-change-me-at-least-32-chars
PORT=3000
API_PORT=3000
DB_PORT=5432
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
LOG_LEVEL=info
# Hostname/IP reachable from the device. See apps/mobile/.env.example.
EXPO_PUBLIC_API_URL=http://localhost:3000/api
